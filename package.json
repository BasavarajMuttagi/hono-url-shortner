{
  "name": "hono-url-shortner",
  "version": "1.0.0",
  "description": "High-throughput, sub-3ms URL shortener and ClickHouse OLAP analytics engine built with Hono and Drizzle ORM",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:load": "k6 run load-tests/redirect.js",
    "test:load:high": "k6 run load-tests/high-load.js",
    "test:load:stampede": "k6 run load-tests/stampede.js",
    "test:load:mixed": "k6 run load-tests/mixed.js",
    "test:load:live": "k6 run load-tests/live-monitor.js",
    "test:load:auth": "k6 run load-tests/auth-bcrypt.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx src/db/seed.ts",
    "db:clean": "tsx src/db/cleanup.ts",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "hono",
    "url-shortener",
    "valkey",
    "clickhouse",
    "postgres",
    "drizzle-orm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clickhouse/client": "^1.25.0",
    "@hono/node-server": "^2.1.9",
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-validator": "^0.9.1",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/host-metrics": "^0.40.0",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "hono-rate-limiter": "^0.5.4",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "uuid": "^14.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
