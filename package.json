{
  "name": "hono-url-shortner",
  "version": "1.0.0",
  "description": "High-throughput, sub-3ms URL shortener and ClickHouse OLAP analytics engine built with Hono and Drizzle ORM",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "keywords": [
    "hono",
    "url-shortener",
    "valkey",
    "clickhouse",
    "postgres",
    "drizzle-orm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "ioredis": "^6.0.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
