# Server Configuration
PORT=8080
NODE_ENV=development
BASE_URL=http://localhost:8080

# PostgreSQL (Aiven Managed)
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require

# Valkey / Redis (Aiven Managed)
REDIS_URL=rediss://default:<password>@<host>:<port>

# ClickHouse OLAP (Aiven Managed)
CLICKHOUSE_URL=https://<host>:<port>
CLICKHOUSE_USER=<user>
CLICKHOUSE_PASSWORD=<password>
CLICKHOUSE_DB=<dbname>

# Privacy Salt for Salted SHA-256 IP Hashing
SALT_SECRET=change-this-to-a-secure-salt-for-privacy-ip-hashing

# JWT Signing Secret
JWT_SECRET=change-this-to-a-secure-jwt-secret-min-32-chars

# Axiom Cloud Observability & OpenTelemetry (https://axiom.co)
AXIOM_TOKEN=<your-axiom-api-token>
AXIOM_DATASET=<traces-dataset-name>
AXIOM_METRICS_DATASET=<metrics-dataset-name>
AXIOM_URL=https://us-east-1.aws.edge.axiom.co
OTEL_SERVICE_NAME=hono-url-shortner

# Development & Integration Testing Seed Credentials
SEED_USER_ID=<uuidv7-user-id>
SEED_USER_EMAIL=<user-email>
SEED_API_KEY=<32-char-api-key>
